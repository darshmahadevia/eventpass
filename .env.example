# Postgres connection string (Neon, Supabase, or the local compose.yaml database).
DATABASE_URL=postgresql://postgres:postgres@localhost:54432/eventpass

# Public origin used in emailed links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Without a key, emails are printed to the server console instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL="EventPass <tickets@example.com>"
